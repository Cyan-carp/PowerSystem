erDiagram
    USERS ||--o{ ALARM_RECORDS : "确认 acked_by"
    DEVICES ||--o{ ALARM_RULES : "配置规则"
    DEVICES ||--o{ ALARM_RECORDS : "产生告警"
    ALARM_RULES ||--o{ ALARM_RECORDS : "触发"
    DEVICES ||--o{ WORK_ORDERS : "关联工单"

    USERS {
        bigint id PK
        varchar username UK
        varchar password_hash
        varchar role
        varchar real_name
        timestamptz created_at
    }
    DEVICES {
        bigint id PK
        varchar device_code UK
        varchar name
        varchar dev_type
        varchar vendor
        varchar group_name
        varchar status
        timestamptz created_at
    }
    ALARM_RULES {
        bigint id PK
        bigint device_id FK
        varchar metric
        varchar operator
        float8 threshold
        varchar level
        boolean enabled
    }
    ALARM_RECORDS {
        bigint id PK
        bigint device_id FK
        bigint rule_id FK
        varchar metric
        varchar level
        float8 value
        varchar status
        bigint acked_by FK
        timestamptz triggered_at
    }
    WORK_ORDERS {
        bigint id PK
        bigint device_id FK
        bigint alarm_id FK
        varchar title
        varchar status
        timestamptz created_at
    }
