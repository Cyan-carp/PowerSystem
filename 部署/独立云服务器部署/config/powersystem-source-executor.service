[Unit]
Description=PowerSystem fixed-scope FRP source executor
Wants=network-online.target
After=network-online.target powersystem-edge-firewall.service
Requires=powersystem-edge-firewall.service

[Service]
Type=simple
User=root
Group=powersystem-source
ExecStart=/usr/bin/python3 -B /opt/powersystem-edge/source-refresh/frp-source-refresh.py serve-executor
Restart=on-failure
RestartSec=30
UMask=0077
RuntimeDirectory=powersystem-source-executor
RuntimeDirectoryMode=0750
StateDirectory=powersystem-source
StateDirectoryMode=0700
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN
ReadWritePaths=/etc/powersystem-edge
ReadOnlyPaths=/etc/powersystem-edge/source-refresh-cloud.json /etc/powersystem-edge/source-refresh.key /etc/powersystem-edge/allowed-admin-ipv4
ReadOnlyPaths=/etc/powersystem-edge/source-refresh-cloud-credentials.json
ReadOnlyPaths=/etc/powersystem-edge/frps.toml /etc/powersystem-edge/frp-token /etc/powersystem-edge/frp-server.key /etc/powersystem-edge/frp-server.crt
MemoryMax=128M
TasksMax=16

[Install]
WantedBy=multi-user.target
