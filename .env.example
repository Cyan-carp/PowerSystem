# Copy to .env and set a local-only TDengine password.
TDENGINE_ROOT_PASSWORD=change-this-local-password

# Stage two: copy this file to .env; preflight-stage2.ps1 fills blank values.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=

# Optional exact local development origin for the Vite WebSocket proxy.
WS_ALLOWED_ORIGINS=

# Optional independent general chat service; old AGENT_URL still serves alarm interpretation.
AGENT_CHAT_URL=
AGENT_CHAT_TIMEOUT_SECONDS=125
AGENT_CHAT_INPUT_CHARS=32000
AGENT_CHAT_RATE=10
AGENT_CHAT_CONCURRENCY=4

# Stage8 BND-M2: local daily-input boundary; unknown questions still pass.
BND_DAILY_GATE_ENABLED=true


# MA-M1 internal operation-agent origin and separate private signing files.
OPS_URL=
OPS_SERVICE_TOKEN_FILE=
MA_ACTOR_KEY_FILE=
