# Copy to stages/07-agent/.env (ignored). Read by the stage7 scripts.
AGENT_ENABLED=true
AGENT_INTERPRET_ENABLED=true
AGENT_URL=http://127.0.0.1:8092
AGENT_BACKEND_URL=http://127.0.0.1:8080
# Must include the API version path, normally /v1, without /chat/completions.
AGENT_LLM_BASE_URL=https://your-provider.example/v1
AGENT_LLM_MODEL=your-tool-capable-model
# Paths relative to repository root. Put ONLY the secret in these files.
AGENT_LLM_API_KEY_FILE=artifacts/stage7-智能体/private/model-api-key
AGENT_SERVICE_TOKEN_FILE=artifacts/stage7-智能体/private/service-token
AGENT_MONITOR_TOKEN_FILE=artifacts/stage7-智能体/private/monitor-token
AGENT_AUDIT_DIR=artifacts/stage7-智能体/runtime
# AGENT_REDIS_URL is assembled from root .env by local scripts; never printed.
# V2-M3 optional search: POST {query,max_results}, response {results:[{title,url,summary,published_at?}]}.
# Chat model base URL is not a search URL. Unconfigured search degrades explicitly.
AGENT_SEARCH_URL=
AGENT_SEARCH_KEY_FILE=
AGENT_MISSES_DIR=artifacts/stage7-智能体/v2m3/knowledge-misses
AGENT_KNOWLEDGE_PATH=stages/07-agent/knowledge/index.json

# generic keeps the existing contract; bocha uses the fixed official endpoint.
AGENT_SEARCH_PROVIDER=generic
