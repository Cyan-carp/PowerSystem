AGENT_LLM_BASE_URL=https://api.deepseek.com
AGENT_LLM_MODEL=your-configured-model
# Registered role for the provider profile (no secret); stage 7 keeps its own channel.
AGENT_MODEL_ROLE=assistant
# V4-S02: only the assistant switch is introduced here; default stays false.
V4_ASSISTANT_ENABLED=false
AGENT_LLM_API_KEY_FILE=private/llm-key
AGENT_SERVICE_TOKEN_FILE=private/service-token
AGENT_SEARCH_KEY_FILE=private/bocha-key
AGENT_REDIS_URL=redis://:replace-me@127.0.0.1:16380/0
RAG_DATABASE_URL=postgresql://user:replace-me@127.0.0.1:5432/agent_rag
AGENT_BACKEND_URL=http://127.0.0.1:8080
AGENT_CHAT_URL=http://127.0.0.1:8093
RAG_QDRANT_URL=http://127.0.0.1:16333
RAG_EMBEDDING_PATH=private/models/multilingual-e5-small
RAG_AUDIT_DIR=artifacts/stage8-agent-rag/audit
RAG_TOTAL_TIMEOUT=120
RAG_MODEL_TIMEOUT=60
RAG_TOOL_TIMEOUT=15
RAG_MAX_ROUNDS=8
RAG_MAX_CALLS=16
RAG_MAX_TOKENS=8192
RAG_INPUT_CHARS=32000
AGENT_CHAT_TIMEOUT_SECONDS=125
AGENT_CHAT_INPUT_CHARS=32000
AGENT_CHAT_RATE=10
AGENT_CHAT_CONCURRENCY=4
# Boundary phase 1: optional presentation / explicit verification, no auto queries.
BND_EVIDENCE_ENABLED=true
BND_VERIFY_ENABLED=true
BND_TELEMETRY_MAX_AGE_SECONDS=120
BND_FUTURE_SKEW_SECONDS=60
BND_VERIFY_MAX_PAGES=10

# MA-M1 internal operation-agent origin and separate private signing files.
OPS_URL=
OPS_SERVICE_TOKEN_FILE=
MA_ACTOR_KEY_FILE=
MA_ENVELOPE_KEY_FILE=
# Optional explicit thinking toggle for providers supporting this protocol.
# Empty keeps the provider default; official Flash candidate uses disabled.
RAG_MODEL_THINKING=
# S03 admission stays disabled by default; query/recovery remains available.
V4_RUNS_ENABLED=false
# S05: generation only; existing owner reads and expiry cleanup survive rollback.
V4_ARTIFACTS_ENABLED=false
RAG_ARTIFACT_DIR=artifacts/stage8-agent-rag/files
# S08: local isolated schedule policy only; no production profile or external delivery.
V4_SCHEDULES_ENABLED=false
