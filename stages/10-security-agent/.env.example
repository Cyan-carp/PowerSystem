# Private file references only. SEC-M1 does not connect the service to a database.
SEC_ENABLED=false
SEC_MODEL=deepseek-v4-flash-0731
SEC_LLM_URL=https://hgapi.dieqiyun.top/v1
SEC_SERVICE_TOKEN_FILE=/run/secrets/sec-service-token
SEC_REQUEST_KEY_FILE=/run/secrets/sec-request-key
SEC_RESULT_KEY_FILE=/run/secrets/sec-result-key
SEC_LLM_API_KEY_FILE=/run/secrets/sec-llm-key
SEC_MODEL_TIMEOUT_SECONDS=30
SEC_ACCEPTANCE_TIMEOUT_EXCEPTION_ENABLED=false
SEC_REVIEW_TTL_SECONDS=300
