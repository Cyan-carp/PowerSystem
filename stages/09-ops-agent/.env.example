# Private values belong in Git-ignored files; never put credentials here.
OPS_ENABLED=false
OPS_WRITE_ENABLED=false
OPS_EXECUTOR_WRITE_KEY_FILE=private/executor-write-key
OPS_APPROVAL_TIMEOUT_SECONDS=1800
OPS_INFRA_ENABLED=false
OPS_EXECUTOR_URL=http://127.0.0.1:8095
OPS_EXECUTOR_TOKEN_FILE=private/executor-token
OPS_EXECUTOR_GRANT_KEY_FILE=private/executor-grant-key
# Only the separate adapter process reads this file; exclude it from the model process environment.
OPS_EXECUTOR_CONFIG_FILE=private/executor.json
OPS_DATABASE_URL=postgresql://ma_ops_runtime:SET_PRIVATE_PASSWORD@127.0.0.1:5432/ma_ops
OPS_REDIS_URL=redis://:SET_PRIVATE_PASSWORD@127.0.0.1:6379/0
OPS_REDIS_PREFIX=ma:runtime:
OPS_SERVICE_TOKEN_FILE=private/ops-service-token
MA_ACTOR_KEY_FILE=private/ma-actor-key
MA_ENVELOPE_KEY_FILE=private/ma-envelope-key
OPS_LLM_API_KEY_FILE=private/ops-llm-key
OPS_LLM_URL=https://hgapi.dieqiyun.top/v1
OPS_MODEL=deepseek-v4.1-flash
OPS_BACKEND_URL=http://127.0.0.1:8080
OPS_SUPERVISOR_URL=http://127.0.0.1:8093
OPS_TASK_TIMEOUT_SECONDS=300
OPS_MODEL_TIMEOUT_SECONDS=60
OPS_TOOL_TIMEOUT_SECONDS=15
OPS_MAX_ROUNDS=8
OPS_MAX_CALLS=16
OPS_MAX_TOKENS=8192
OPS_TOOL_CHARS=60000
OPS_USER_ACTIVE_LIMIT=1
OPS_GLOBAL_CONCURRENCY=2
OPS_QUEUE_CAPACITY=20
OPS_LEASE_SECONDS=50
OPS_HEARTBEAT_SECONDS=10
OPS_VERIFY_MAX_PAGES=10
OPS_AUDIT_DIR=artifacts/stage9-ops-agent/audit
OPS_SECURITY_ENABLED=false
OPS_SECURITY_URL=http://127.0.0.1:8100
SEC_SERVICE_TOKEN_FILE=private/sec-service-token
SEC_REQUEST_KEY_FILE=private/sec-request-key
SEC_RESULT_KEY_FILE=private/sec-result-key
