# KEEP DISABLED until ICP filing is approved and the domain certificate is issued.
# Create the footer include with the actual approved number before enabling.
server {
    listen 80;
    listen [::]:80;
    server_name www.cyancarp.cn;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/powersystem-acme;
        try_files $uri =404;
    }
    location / { return 301 https://www.cyancarp.cn$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name www.cyancarp.cn;
    ssl_certificate /etc/letsencrypt/live/www.cyancarp.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/www.cyancarp.cn/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    location / {
        proxy_pass http://127.0.0.1:3667;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_buffering off;
        # HTML only; no rewriting of API, JS or WebSocket responses.
        proxy_set_header Accept-Encoding "";
        sub_filter_once on;
        include /etc/nginx/powersystem-icp-footer.conf;
    }
}
