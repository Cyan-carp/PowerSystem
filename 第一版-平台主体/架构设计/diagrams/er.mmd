erDiagram
    USERS ||--o{ ALARM_RECORDS : "确认 acked_by"
    DEVICES ||--o{ ALARM_RULES : "配置规则"
    DEVICES ||--o{ ALARM_RECORDS : "产生告警"
    ALARM_RULES ||--o{ ALARM_RECORDS : "触发"
    DEVICES ||--o{ TELEMETRY_INBOX : "可靠收件"

    USERS {
        bigint id PK
        varchar username UK
        varchar password_hash
        varchar role
        varchar real_name
        timestamptz created_at
        timestamptz updated_at
    }
    DEVICES {
        bigint id PK
        varchar device_code UK
        varchar name
        varchar dev_type
        varchar vendor
        varchar station_code
        varchar group_name
        timestamptz deleted_at
        timestamptz created_at
    }
    ALARM_RULES {
        bigint id PK
        bigint device_id FK
        varchar metric
        varchar operator
        float8 threshold
        varchar level
        boolean enabled
        timestamptz created_at
    }
    ALARM_RECORDS {
        bigint id PK
        bigint device_id FK
        bigint rule_id FK
        varchar metric
        varchar level
        float8 value
        varchar status
        bigint acked_by FK
        timestamptz acked_at
        timestamptz recovered_at
        timestamptz triggered_at
    }
    TELEMETRY_INBOX {
        bigint id PK
        bigint device_id FK
        varchar run_id
        bigint seq
        bigint ts_ms
        jsonb payload
        timestamptz received_at
        timestamptz processed_at
    }
